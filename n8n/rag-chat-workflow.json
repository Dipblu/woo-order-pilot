      "parameters": {
        "jsCode": "const question = $('Webhook - Chat').first().json.body?.question || \"How long will my delivery take?\";\nconst items = $input.all();\nconst topSimilarity = items.length > 0 ? items[0].json.similarity : 0;\nconst context = items.map(item => item.json.content).join(\"\\n\\n---\\n\\n\");\nconst THRESHOLD = 0.2;\nreturn [{ json: { question, context, topSimilarity, belowThreshold: topSimilarity < THRESHOLD } }];"
      },
