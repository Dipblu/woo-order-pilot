      "parameters": {
        "jsCode": "const windowMinutes = 10;\nlet ip = $('Webhook - Chat').item.json.headers['x-real-ip'] ||\n  $('Webhook - Chat').item.json.headers['x-forwarded-for']?.split(',').pop()?.trim() ||\n  'unknown';\n\nif (!/^[0-9a-fA-F:.]{1,45}$/.test(ip)) ip = 'unknown';\n\nconst windowMs = windowMinutes * 60 * 1000;\nconst windowStart = new Date(Math.floor(Date.now() / windowMs) * windowMs).toISOString();\nconst previousWindowStart = new Date(Math.floor(Date.now() / windowMs) * windowMs - windowMs).toISOString();\n\nreturn [{ json: { ...$json, rateLimitIp: ip, windowStart, previousWindowStart, limit: 20 } }];"
