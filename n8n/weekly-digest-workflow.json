      "id": "71b34e15-7dff-437b-baf3-db95d6680e5b",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with window_bounds as (\n  select now() - interval '7 days' as since\n),\nunanswered as (\n  select\n    count(*) as total,\n    string_agg(\n      '• ' || replace(replace(replace(question, '&', '&amp;'), '<', '&lt;'), '>', '&gt;')\n        || '  (' || reason || ', ' || round(similarity_score::numeric, 2) || ')',\n      E'\\n' order by created_at desc\n    ) as lines\n  from unanswered_questions, window_bounds\n  where created_at >= window_bounds.since\n),\nesc as (\n  select\n    count(*) as total,\n    count(*) filter (where email_status = 'failed') as failed,\n    count(*) filter (where suppressed) as suppressed\n  from escalations, window_bounds\n  where created_at >= window_bounds.since\n)\nselect\n  unanswered.total::int as unanswered_total,\n  esc.total::int as escalation_total,\n  esc.failed::int as escalation_failed,\n  esc.suppressed::int as escalation_suppressed,\n  coalesce(unanswered.lines, '(none)') as unanswered_lines\nfrom unanswered, esc;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -448,
        -112
      ],
      "id": "b022a05b-ebbf-410b-bb59-a88445d2e987",
      "name": "Get Digest Data",
      "credentials": {
        "postgres": {
          "id": "nII9UJDNmVB93OrV",
          "name": "Postgres account"
        }
      }
    },
    {
