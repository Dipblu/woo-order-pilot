    {
      "parameters": {
        "jsCode": "const isWebhook = $json.body !== undefined;\nconst input = isWebhook ? $json.body : $json;\n\nreturn [{\n  json: {\n    orderNumber: String(input.orderNumber || '').trim(),\n    email: String(input.email || '').trim().toLowerCase(),\n    viaWebhook: isWebhook,\n  },\n}];"
      },
      "id": "11d87762-7ebf-4204-aace-a508420201a2",
      "name": "Normalize Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1024,
        -256
      ]
    },
    {
      "parameters": {
        "resource": "order",
        "operation": "get",
        "orderId": "={{ $json.orderNumber }}"
      },
      "id": "5edbe214-f355-4155-96a9-6df866e050e6",
      "name": "Get Order",
      "type": "n8n-nodes-base.wooCommerce",
      "typeVersion": 1,
      "position": [
        -640,
        -256
      ],
      "credentials": {
        "wooCommerceApi": {
          "id": "bTt0978QE8WivqYk",
          "name": "WooCommerce account 2"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const input = $('Normalize Input').first().json;\nconst orderResult = $json;\nconst cfg = $('Config').first().json;\n\nconst GENERIC_FAIL = `We couldn't verify an order with that order number and email combination. Please double-check both and try again, or contact us at ${cfg.contactEmail} if you need help.`;\n\nif (!input.orderNumber || !input.email || orderResult.error || !orderResult.id) {\n  return [{ json: { success: false, message: GENERIC_FAIL, viaWebhook: input.viaWebhook } }];\n}\n\nconst billingEmail = (orderResult.billing?.email || '').trim().toLowerCase();\nif (billingEmail !== input.email) {\n  return [{ json: { success: false, message: GENERIC_FAIL, viaWebhook: input.viaWebhook } }];\n}\n\nconst items = (orderResult.line_items || []).map((li) => `${li.quantity}x ${li.name}`).join(', ') || 'none listed';\nconst shipping = orderResult.shipping?.address_1 ? orderResult.shipping : orderResult.billing;\n\n// Mask EVERY token containing a digit, not just the leading one. The old\n// anchored regex only fired on the first token, so \"Unit 5B, 123 Mabini St\"\n// passed through with the house number exposed.\nconst maskStreet = (s) =>\n  String(s || '')\n    .split(/\\s+/)\n    .filter(Boolean)\n    .map((t) => (/\\d/.test(t) ? '•••' : t))\n    .reduce((acc, t) => (t === '•••' && acc[acc.length - 1] === '•••' ? acc : (acc.push(t), acc)), [])\n    .join(' ');\n\n// WooCommerce stores `state` as a code, not a name. Numeric codes are opaque to\n// a customer (PH \"00\" = Metro Manila) so drop them; lettered codes (\"CA\") stay.\nconst stateCode = String(shipping?.state || '');\nconst stateLabel = /^\\d+$/.test(stateCode) ? '' : stateCode;\n\nconst address = [maskStreet(shipping?.address_1), shipping?.city, stateLabel, shipping?.postcode]\n  .filter(Boolean)\n  .join(', ');\n\nconst message = `Order #${orderResult.number} status: ${orderResult.status}. Items: ${items}. Total: ${orderResult.currency} ${orderResult.total}.` +\n  (address ? ` Delivery address: ${address}.` : '');\n\nreturn [{\n  json: {\n    success: true,\n    message,\n    order: {\n      number: orderResult.number,\n      status: orderResult.status,\n      total: orderResult.total,\n      currency: orderResult.currency,\n      items,\n      address,\n    },\n    viaWebhook: input.viaWebhook,\n  },\n}];"
      },
